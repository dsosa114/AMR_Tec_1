# EKF: fuses wheel odometry velocity + BNO055 angular velocity/acceleration
ekf_filter_node:
  ros__parameters:
    frequency: 30.0
    sensor_timeout: 0.2
    two_d_mode: true
    publish_tf: true

    map_frame: map
    odom_frame: odom
    base_link_frame: base_link
    world_frame: odom

    # Wheel odometry: forward velocity only
    odom0: /wheel/odom
    odom0_config: [false, false, false,    # x, y, z
                   false, false, false,    # roll, pitch, yaw
                   true,  false, false,    # vx, vy, vz
                   false, false, false,    # vroll, vpitch, vyaw
                   false, false, false]    # ax, ay, az
    odom0_queue_size: 10
    odom0_differential: false

    # BNO055: yaw rate + forward acceleration
    imu0: /imu/data
    imu0_config: [false, false, false,
                  false, false, false,
                  false, false, false,
                  false, false, true,      # vyaw
                  true,  false, false]     # ax
    imu0_queue_size: 20
    imu0_differential: false
    imu0_remove_gravitational_acceleration: false  # linear-accel (gravity-free) mode

    # Later: GNSS / map localization (navsat_transform_node, map->odom EKF)
    # odom1: /gps/odom
