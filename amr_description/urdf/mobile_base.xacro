<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Null inertial element. This is needed to make the model work with
         Gazebo. -->
  <xacro:macro name="null_inertial">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-0.103538876994477 0.0222986727626558  0.130202562302216"
        rpy="0 0 ${-pi/2}" />
      <mass
        value="30.2192194697933" />
      <inertia
        ixx="1.1404114097681"
        ixy="0.0547930702310783"
        ixz="0.0201944026363161"
        iyy="0.409771420291759"
        iyz="-0.0194016060635621"
        izz="1.45153548756467" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 ${-pi/2}" />
      <geometry>
        <mesh
          filename="package://amr_description/meshes/Chasis_link.STL" />
      </geometry>
      <material
        name="base_color">
        <color
          rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 ${-pi/2}" />
      <geometry>
        <mesh
          filename="package://amr_description/meshes/Chasis_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
  </joint>
  
  <link name="right_steering_link">
    <xacro:null_inertial/>
  </link>

  <joint name="right_front_position_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_steering_link"/>
    <origin
      xyz="0.7137 -0.49047 0.045273"
      rpy="0 0.00030616 ${-pi/2}" />
    <axis xyz="0 0 1" />
  </joint>

  <joint name="front_right_steering_joint" type="revolute">
    <parent link="right_steering_link"/>
    <child link="front_right_axle_carrier"/>
    <axis xyz = "0 0 1"/>
    <limit lower="-0.523599" upper="0.523599" effort="0.5649" velocity="4.553"/>
    <!-- <limit lower="-0.3" upper="0.3" effort="0.5649" velocity="4.553"/> -->
  </joint>
  <link name="front_right_axle_carrier">
    <xacro:null_inertial/>
  </link>

  <link
    name="front_right_wheel_link">
    <inertial>
      <origin
        xyz="-0.00566401631473373 9.90724435080415E-05 -0.000271963367299288"
        rpy="0 0 0" />
      <mass
        value="6.69183973985027" />
      <inertia
        ixx="0.357347212224778"
        ixy="-1.07740917030233E-07"
        ixz="4.64182261268584E-05"
        iyy="0.204903978015561"
        iyz="4.80243600331509E-06"
        izz="0.204920649676514" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://amr_description/meshes/front_right_wheel_link.STL" />
      </geometry>
      <material
        name="wheel_color">
        <color
          rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://amr_description/meshes/front_right_wheel_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="front_right_wheel_joint"
    type="continuous">
    <!-- <origin
      xyz="0.7137 -0.49047 0.045273"
      rpy="0 0.00030616 ${-pi/2}" /> -->
    <parent
      link="front_right_axle_carrier" />
    <child
      link="front_right_wheel_link" />
    <axis
      xyz="-1 0 -0.00030616" />
    <dynamics
      damping="0.5"
      friction="1" />
  </joint>

  <link name="left_steering_link">
    <xacro:null_inertial/>
  </link>

  <joint name="left_front_position_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_steering_link"/>
    <origin
      xyz="0.71363 0.48953 0.044772"
      rpy="0 0.00030616 ${-pi/2}" />
    <axis xyz="0 0 1" />
  </joint>

  <joint name="front_left_steering_joint" type="revolute">
    <parent link="left_steering_link"/>
    <child link="front_left_axle_carrier"/>
    <axis xyz = "0 0 1"/>
    <limit lower="-0.523599" upper="0.523599" effort="0.5649" velocity="4.553"/>
    <!-- <limit lower="-0.3" upper="0.3" effort="0.5649" velocity="4.553"/> -->
  </joint>
  <link name="front_left_axle_carrier">
    <xacro:null_inertial/>
  </link>
  <link
    name="front_left_wheel_link">
    <inertial>
      <origin
        xyz="0.00566402902001811 0.000174876625691156 0.000230333408740846"
        rpy="0 0 0" />
      <mass
        value="6.69183974290597" />
      <inertia
        ixx="0.357347211995644"
        ixy="2.73805309929157E-08"
        ixz="4.63975052563284E-05"
        iyy="0.204902723124111"
        iyz="7.69970830090359E-07"
        izz="0.204921904315497" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://amr_description/meshes/front_left_wheel_link.STL" />
      </geometry>
      <material
        name="wheel_color">
        <color
          rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://amr_description/meshes/front_left_wheel_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="front_left_wheel_joint"
    type="continuous">
    <!-- <origin
      xyz="-0.48953 0.71363 0.044772"
      rpy="0 0.00030616 0" /> -->
    <parent
      link="front_left_axle_carrier" />
    <child
      link="front_left_wheel_link" />
    <axis
      xyz="1 0 0.00030616" />
    <dynamics
      damping="0.5"
      friction="1" />
  </joint>
  <link
    name="rear_right_wheel_link">
    <inertial>
      <origin
        xyz="-0.00566416893167465 -0.000175443022534916 0.000226429859826904"
        rpy="0 0 0" />
      <mass
        value="6.69183959859615" />
      <inertia
        ixx="0.357347210530256"
        ixy="2.71918139990335E-08"
        ixz="4.69355611226319E-05"
        iyy="0.204902726766514"
        iyz="-8.1768483672708E-07"
        izz="0.204921899865492" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://amr_description/meshes/rear_right_wheel_link.STL" />
      </geometry>
      <material
        name="wheel_color">
        <color
          rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://amr_description/meshes/rear_right_wheel_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="rear_right_wheel_joint"
    type="continuous">
    <origin
      xyz="-0.686 -0.44847 0.038273"
      rpy="0 0.00030616 ${pi/2}" />
    <parent
      link="base_link" />
    <child
      link="rear_right_wheel_link" />
    <axis
      xyz="-1 0 -0.00030616" />
    <dynamics
      damping="0.5"
      friction="1" />
  </joint>
  <link
    name="rear_left_wheel_link">
    <inertial>
      <origin
        xyz="0.00566398917654387 0.000167290260409625 0.000236661415633888"
        rpy="0 0 0" />
      <mass
        value="6.69183133120593" />
      <inertia
        ixx="0.357347200837873"
        ixy="3.34915201437461E-08"
        ixz="4.63916616915813E-05"
        iyy="0.20490267191407"
        iyz="1.3681642636337E-07"
        izz="0.204921942432232" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://amr_description/meshes/rear_left_wheel_link.STL" />
      </geometry>
      <material
        name="wheel_color">
        <color
          rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://amr_description/meshes/rear_left_wheel_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="rear_left_wheel_joint"
    type="continuous">
    <origin
      xyz="-0.68637 0.44753 0.038266"
      rpy="0 0.00030616 ${pi/2}" />
    <parent
      link="base_link" />
    <child
      link="rear_left_wheel_link" />
    <axis
      xyz="1 0 0.00030616" />
    <dynamics
      damping="0.5"
      friction="1" />
  </joint>
</robot>