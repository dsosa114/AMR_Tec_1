# Import from the workspace root with:
#   vcs import src/third_party < src/dependencies.repos
#
# This source pin supports both ROS 2 Humble and Jazzy. Released ROS stacks
# (Velodyne, RTAB-Map, robot_localization, Nav2, RPLidar, and u-blox) are
# installed through rosdep/APT; see docs/development-environments.md.
repositories:
  zed-ros2-wrapper:
    type: git
    url: https://github.com/stereolabs/zed-ros2-wrapper.git
    version: humble-v5.1.0
